# Starlight keyboard layout: US PC set-1 positions
# key.<scancode>=normal shift altgr shift_altgr
name=US
base=pc105

key.02=1 !
key.03=2 @
key.04=3 U+0023
key.05=4 $
key.06=5 %
key.07=6 ^
key.08=7 &
key.09=8 *
key.0A=9 (
key.0B=0 )
key.0C=- _
key.0D== +
key.10=q Q
key.11=w W
key.12=e E
key.13=r R
key.14=t T
key.15=y Y
key.16=u U
key.17=i I
key.18=o O
key.19=p P
key.1A=[ {
key.1B=] }
key.1E=a A
key.1F=s S
key.20=d D
key.21=f F
key.22=g G
key.23=h H
key.24=j J
key.25=k K
key.26=l L
key.27=U+003B :
key.28=' "
key.29=` ~
key.2B=U+005C |
key.2C=z Z
key.2D=x X
key.2E=c C
key.2F=v V
key.30=b B
key.31=n N
key.32=m M
key.33=, <
key.34=. >
key.35=/ ?
key.39=space space
